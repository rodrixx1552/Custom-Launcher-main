<div id="mainContainer">
    <div class="top-section">
        <div class="logo-wrapper">
            <img src="../assets/los_papus/logo.png" alt="LosPapus Lover" class="main-logo">
        </div>
    </div>

    <div class="middle-section">
        <div class="version-card glass">
            <div class="version-badge">ACTIVE DEPLOYMENT</div>
            <h2 class="version-edition">JAVA EDITION</h2>
            <div id="selected-version-text" class="version-number">Minecraft 1.20.1</div>
            
            <div class="server-status-pill">
                <div class="pulse-dot"></div>
                <span id="server-ping-text">SERVER ONLINE | 12/100</span>
            </div>
        </div>
    </div>

    <div class="bottom-section">
        <div class="play-area">
            <div class="play-glow"></div>
            <button class="btn-play-custom" id="play-btn">PLAY</button>
        </div>

        <div class="user-footer">
            <div class="version-info">
                CORE v1.2.0-STABLE <span class="build-sep">|</span> BUILD: 2024.03
            </div>
            <div class="user-display">
                <i class="fas fa-crown"></i>
                <span id="user-name-text">EL_PAPU_ADMIN</span>
            </div>
            <div class="social-icons">
                <a href="#" title="Discord"><i class="fab fa-discord"></i></a>
                <a href="#" class="store-link" title="Store" onclick="window.renderStoreTab(); document.querySelectorAll('.nav-item').forEach(i=>i.classList.remove('active'));"><i class="fas fa-shopping-cart"></i></a>
                <a href="#" title="Source"><i class="fab fa-github"></i></a>
            </div>
        </div>
    </div>
</div>
