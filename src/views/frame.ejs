<div id="frameBar" class="shadow-sm">
    <div class="frame-wrapper"></div>
   
    <div id="frame-win">
        <div class="frame-win-header">
            <img src="<%=srcIcon%> " alt="icon" class="frame-app-icon">
            <span class="frame-app-title"> <%=title%> </span>
        </div>
        <div class="frame-actions">
            <button class="frameBtn btnFullscreen" id="frameBtn_fullscreen" title="Pantalla Completa">
                <i class="fas fa-expand"></i>
            </button>
            <button class="frameBtn btnMinimize" id="frameBtn_minimize" title="Minimizar">
                <i class="fa fa-window-minimize"></i> <!--Al final terminamos usando el icono de fa :p-->
            </button>
            <button class="frameBtn btnMaximized" id="frameBtn_maximize" title="Maximizar / Restaurar">
                <i class="fa fa-window-maximize"></i>
            </button>
            <button class="frameBtn btnClose" id="frameBtn_close" title="Cerrar">
                <i class="fas fa-x"></i>
            </button>
        </div>
    </div>
</div>